[Unit]
Description=Nexzen ERP Background Worker (ARQ)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=nexzen
Group=nexzen
WorkingDirectory=/opt/nexzen-erp/backend
EnvironmentFile=/etc/nexzen-erp/.env
ExecStart=/opt/nexzen-erp/backend/.venv/bin/python -m arq app.workers.settings.WorkerSettings
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Systemd sandboxing / hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/log/nexzen-erp

[Install]
WantedBy=multi-user.target
