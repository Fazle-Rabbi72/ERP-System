# Nexzen ERP - environment template.
# Copy to .env (scripts/setup does this) and fill in. NEVER commit .env.
# Values marked CHANGE_ME must be replaced; the app refuses to start in
# production if they are left unchanged.
# Same variables work for local services, Neon/Redis Cloud (demo) and
# on-premise servers. See docs/hosted-services.md.

# --- General ---
APP_ENV=development                 # development | test | production
DEPLOYMENT_MODE=cloud               # cloud (multi-tenant SaaS) | onprem (single-tenant)
ONPREM_TENANT_ID=                   # required only when DEPLOYMENT_MODE=onprem (a UUID)
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL 16 (local install OR Neon) ---
# Neon: DB_HOST = the POOLED host (contains "-pooler"), DB_SSL_MODE=verify-full.
# Local: DB_HOST=localhost, DB_SSL_MODE=disable.
# App role must NOT be a superuser and must NOT own tables (so RLS applies).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexzen_erp
DB_SSL_MODE=disable                 # disable | require | verify-full
DB_APP_USER=nexzen_app
DB_APP_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=30000
# Set to 0 if a pooler ever reports "prepared statement does not exist".
DB_STATEMENT_CACHE_SIZE=100
# Privileged role used only by Alembic migrations. On Neon set DB_MIGRATOR_HOST
# to the DIRECT host (without "-pooler"). Leave empty to reuse DB_HOST.
DB_MIGRATOR_HOST=
DB_MIGRATOR_USER=nexzen_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME
# Used only by the DB bootstrap script (added in F3). On Neon: the owner role.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME

# --- Redis 7 (local install OR Redis Cloud) ---
# Hosted Redis: REDIS_SSL=true if the provider endpoint uses TLS, password required.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
# Free hosted plans cap concurrent connections (Redis Cloud free: 30).
REDIS_MAX_CONNECTIONS=10

# --- Background Worker (ARQ) ---
ARQ_POLL_DELAY_SECONDS=2.0
ARQ_MAX_JOBS=10

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Optional Seed (used only by `make seed` / `python -m app.seed`) ---
SEED_TENANT_CODE=nexzen-demo
SEED_TENANT_NAME="Nexzen Solution Ltd."
SEED_ADMIN_EMAIL=admin@nexzen.com
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD=CHANGE_ME

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
